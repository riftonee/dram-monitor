# Copy to .env and fill in real values. .env is gitignored — never commit it.
# In GitHub Actions these come from repo Secrets instead.

# LLM backend for triage + the daily brief: "anthropic" (default) or "gemini".
# Gemini Flash has a generous free tier and is far cheaper for the every-30-min
# triage pass. Per-task model ids are overridable too (see config.py):
#   ANTHROPIC_TRIAGE_MODEL / ANTHROPIC_BRIEF_MODEL / GEMINI_TRIAGE_MODEL / GEMINI_BRIEF_MODEL
LLM_PROVIDER=anthropic

# Needed when LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=sk-ant-...
# Needed when LLM_PROVIDER=gemini (free tier: https://aistudio.google.com/apikey):
GEMINI_API_KEY=

RESEND_API_KEY=re_...

# Optional extra news sources (the monitor works without these — they add depth).
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
# SEC EDGAR asks for a descriptive User-Agent with a contact. Set yours here so
# it stays out of the public repo (e.g. "dram-monitor you@example.com").
EDGAR_USER_AGENT=

# Who gets the briefing. One address, or a comma-separated list for several:
#   EMAIL_TO=you@example.com, someone@else.com
EMAIL_TO=you@example.com

# Sender. For testing without verifying a domain, use Resend's shared address:
#   EMAIL_FROM=onboarding@resend.dev   (only delivers to your own account email,
#                                       so it can't reach additional recipients)
# For production, verify a domain in Resend and use e.g. dram-monitor@yourdomain.com
# (the local part is arbitrary and needs no mailbox).
EMAIL_FROM=onboarding@resend.dev
